{
  "name": "@matt3010/promptkit",
  "version": "0.10.0",
  "private": true,
  "description": "Backend-agnostic web terminal UI with a small structured protocol.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/promptkit.browser.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "npm run build:modules && npm run build:browser",
    "build:modules": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:browser": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/promptkit.browser.js",
    "browser:smoke": "node scripts/smoke-browser-bundle.mjs",
    "prepare": "npm run build",
    "demo": "npm run build && node examples/demo/server.mjs",
    "demo:smoke": "node scripts/smoke-demo.mjs && node scripts/smoke-action-feedback.mjs && node scripts/smoke-remote-actions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test:coverage && npm run build && npm run browser:smoke && npm run demo:smoke"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "0.28.2",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
